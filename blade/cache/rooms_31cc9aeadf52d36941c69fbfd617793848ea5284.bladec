<ol>
 <?php $__currentLoopData = $rooms; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $room): $loop = $this->incrementLoopIndices();  ?>
 <li>
 Room Type: <?php echo \htmlentities($room['roomType'] ?? 'No Room Type'??'', ENT_QUOTES, 'UTF-8', false); ?><br>
 Room Number: <?php echo \htmlentities($room['roomNumber'] ?? 'No Room Number'??'', ENT_QUOTES, 'UTF-8', false); ?><br>
 Price: $<?php echo \htmlentities(isset($room['price']) ? number_format($room['price'], 2) : 'No Price'??'', ENT_QUOTES, 'UTF-8', false); ?><br>
 Offer Price: $<?php echo \htmlentities(isset($room['offer_price']) ? number_format($room['offer_price'], 2) : 'No Offer Price'??'', ENT_QUOTES, 'UTF-8', false); ?><br>
 Amenities: <?php echo \htmlentities($room['amenities'] ?? 'No Amenities'??'', ENT_QUOTES, 'UTF-8', false); ?><br>
 Status: <?php echo \htmlentities($room['status'] ?? 'No Status'??'', ENT_QUOTES, 'UTF-8', false); ?><br>
 </li>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
</ol>